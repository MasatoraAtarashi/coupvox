# ローカル開発用の環境変数（.dev.vars はコミットされない）
# cp .dev.vars.example .dev.vars して、使うものだけ埋める。
# 未設定でもアプリは動く（Jev トリアージだけがスキップされる）。

# Jev (TypeSafe System One) — https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# 招待リンクを組み立てるときの公開 URL
APP_URL=http://localhost:5173

# Google OAuth（Google Cloud Console で発行）。未設定ならログインだけ使えない
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# セッション cookie の署名鍵。localhost では未設定でも固定の開発鍵で動く
SESSION_SECRET=
